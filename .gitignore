```gitignore
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
.ENV
.env
.env.local
.env.*
requirements.txt.bak
pip-log.txt
pip-delete-this-directory.txt

# IDE
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Logs
*.log

# Coverage
.coverage
coverage/
htmlcov/

# Testing
.pytest_cache/
.mypy_cache/
.hypothesis/

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/
.installed.cfg
*.egg

# OS generated files
.DS_Store
Thumbs.db
```